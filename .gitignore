# ===============================================================================
# Git Ignore Configuration for GeoFusion AI
# ===============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
GeoFusion1.pbl/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Zip Archives & Large Temporary Files
*.zip
*.tar.gz
*.7z

# Data Directories
data/raw/sentinel1/*
!data/raw/sentinel1/.gitkeep
data/raw/sentinel2/*
!data/raw/sentinel2/.gitkeep
data/raw/labels/*
!data/raw/labels/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Keep Dataset Splits & Class Mapping Tracked
!data/class_mapping.json
!data/users.json
!data/splits/*.csv

# Model Checkpoints (Keep Final Model Tracked)
!models/GeoFusion_AI_Final.pth
!models/.gitkeep

# Output Maps & Graphs
outputs/maps/*
!outputs/maps/.gitkeep

# Local Credentials & Secrets
credentials.json
.env
.env.*
!.env.example
