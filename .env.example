# ===============================================================================
# GeoFusion AI — Production Environment Variables Template
# ===============================================================================
# Port allocated dynamically by Render (defaults to 8501 for local testing)
PORT=8501

# Secret Key for JWT / Session signing
GEOFUSION_SECRET_KEY=

# Default Admin User Credentials (Optional Overrides)
GEOFUSION_ADMIN_EMAIL=
GEOFUSION_ADMIN_PASSWORD=
